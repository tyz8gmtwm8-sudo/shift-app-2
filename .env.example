# =============================================================
# 環境変数の見本ファイル
# このファイルをコピーして「.env.local」という名前で保存し、値を書き換えてください。
#   cp .env.example .env.local
# ⚠️ .env.local は秘密情報なので GitHub に公開しないでください（.gitignore で除外済み）
# =============================================================

# --- Supabase（Project Settings → API Keys / Data API で確認） ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx
# シークレットキー（強い権限。絶対に公開しない）
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx

# --- このアプリの URL（招待メールのリンク先に使用） ---
# ローカル: http://localhost:3000  / 本番: https://あなたのアプリ.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Google スプレッドシート（サービスアカウントの JSON キーから転記） ---
GOOGLE_SERVICE_ACCOUNT_EMAIL=shift-app@your-project.iam.gserviceaccount.com
# JSON の "private_key" の値を、ダブルクォートごと1行で貼り付け
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nxxxx\n-----END PRIVATE KEY-----\n"
# スプレッドシートの URL の /d/ と /edit の間の文字列
GOOGLE_SPREADSHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxx
